# Resolver API used by the send and recipient portal pages.
# Local: your local resolver service, typically http://localhost:4000
# Production/testnet: the deployed resolver base URL
VITE_RESOLVER_URL=http://localhost:4000

# L1 network used by the Send Deposit form.
# Local example:
#   VITE_L1_CHAIN_ID=31337
#   VITE_L1_CHAIN_NAME=Local L1
#   VITE_L1_RPC_URL=http://localhost:5010
# Production/testnet example (Sepolia):
#   VITE_L1_CHAIN_ID=11155111
#   VITE_L1_CHAIN_NAME=Sepolia
#   VITE_L1_RPC_URL=https://sepolia.infura.io/v3/<key>
#   VITE_L1_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
VITE_L1_CHAIN_ID=31337
VITE_L1_CHAIN_NAME=Local L1
VITE_L1_RPC_URL=http://localhost:5010
VITE_L1_BLOCK_EXPLORER_URL=

# Prividium network used for login and the Transfer page.
# Local example:
#   VITE_PRIVIDIUM_CHAIN_ID=6565
#   VITE_PRIVIDIUM_CHAIN_NAME=Prividium Local
#   VITE_PRIVIDIUM_RPC_URL=http://localhost:8000/rpc
#   VITE_PRIVIDIUM_AUTH_BASE_URL=http://localhost:3001
#   VITE_PRIVIDIUM_API_BASE_URL=http://localhost:8000
# Production/testnet example:
#   VITE_PRIVIDIUM_CHAIN_ID=<your deployed chain id>
#   VITE_PRIVIDIUM_CHAIN_NAME=<your deployed chain name>
#   VITE_PRIVIDIUM_RPC_URL=https://<your-prividium-host>/rpc
#   VITE_PRIVIDIUM_AUTH_BASE_URL=https://<your-auth-host>
#   VITE_PRIVIDIUM_API_BASE_URL=https://<your-prividium-host>
#   VITE_PRIVIDIUM_BLOCK_EXPLORER_URL=https://<your-explorer-host>
VITE_PRIVIDIUM_CHAIN_ID=6565
VITE_PRIVIDIUM_CHAIN_NAME=Prividium Local
VITE_PRIVIDIUM_BLOCK_EXPLORER_URL=
VITE_PRIVIDIUM_RPC_URL=http://localhost:8000/rpc
VITE_PRIVIDIUM_CLIENT_ID=
VITE_PRIVIDIUM_AUTH_BASE_URL=http://localhost:3001
VITE_PRIVIDIUM_API_BASE_URL=http://localhost:8000

# Required in every environment:
# - VITE_PRIVIDIUM_CLIENT_ID
# - VITE_PRIVIDIUM_AUTH_BASE_URL
# - VITE_PRIVIDIUM_API_BASE_URL
# - VITE_RESOLVER_URL
#
# For local development, the defaults above are usually enough once you fill in
# VITE_PRIVIDIUM_CLIENT_ID.
# For production/testnet, replace every localhost value with the deployed URLs
# and set the L1/Prividium chain ids and names to match the target environment.
